# Copy this file to .env and fill in your real values.
# .env is in .gitignore — never commit real secrets.
#
# Note: this project's secrets are completely separate from the
# server's secrets (hr-mcp-server-langchain/.env). The client never
# sees the server's GEMINI_API_KEY (used there only for embeddings) —
# it only needs its own key for whichever LLM it uses to hold the
# conversation.

# Which provider client.js uses. Defaults to "claude" if unset.
# MODEL_PROVIDER=claude
# MODEL_PROVIDER=gemini
# MODEL_PROVIDER=ollama

# Needed if MODEL_PROVIDER=claude (or unset)
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Needed if MODEL_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=your_gemini_model_here

# Where the standalone MCP server is running (started separately)
MCP_SERVER_URL=http://localhost:3000/mcp

# Needed if MODEL_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
